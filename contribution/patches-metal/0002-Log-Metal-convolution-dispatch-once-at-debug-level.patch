From 371dd95f4ef19102b27d065a11524c4842534bc8 Mon Sep 17 00:00:00 2001
From: nabils <nabileo477@gmail.com>
Date: Mon, 2 Nov 2026 07:01:46 +0700
Subject: [PATCH 2/2] Log Metal convolution dispatch once at debug level

Print the Metal device name, image size and kernel size the first time a
convolution runs on the GPU, using siril_log_debug. The message appears
only in builds where siril_log_debug is active (debug build types), and
is emitted once per process to avoid output in the iteration loop.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/algos/metal_convolution.mm | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/src/algos/metal_convolution.mm b/src/algos/metal_convolution.mm
index 2b98f76..da245b1 100644
--- a/src/algos/metal_convolution.mm
+++ b/src/algos/metal_convolution.mm
@@ -23,8 +23,10 @@
 #include <climits>
 #include <cstdint>
 #include <cstring>
+#include <mutex>
 
-#include "metal_convolution.h"
+#include "core/siril.h"
+#include "algos/metal_convolution.h"
 
 namespace {
 const char *shader_source = R"metal(
@@ -144,6 +146,11 @@ int siril_metal_convolve_float(const float *input, const float *kernel,
 		[command waitUntilCompleted];
 		if (command.status != MTLCommandBufferStatusCompleted) return 0;
 		std::memcpy(output, destination.contents, bytes);
+		static std::once_flag logged;
+		std::call_once(logged, [&] {
+			siril_log_debug("Metal convolution: device %s, %dx%d k%d\n",
+					backend.device.name.UTF8String, width, height, kernel_size);
+		});
 		return 1;
 	}
 }
